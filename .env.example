# BLP Agent Console — environment
# Copy to .env.local for local dev; set the same vars on Netlify for production.

# Leads Log spreadsheet (heartbeats land in its "Agent Status" tab).
# Defaults to the BLP Leads Log; override only for testing.
#SHEET_ID=

# Google service account with Editor access to the Leads Log.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Team passcode gating the app. Unset = open (local dev only).
BLP_APP_ACCESS_KEY=

# Key heartbeat reporters send in x-blp-key to POST /api/agents/heartbeat.
# Reporters may keep posting to the Sales Console instead — same status tab.
BLP_AGENT_KEY=

# Google sign-in (domain-restricted OAuth). Add
# <PUBLIC_BASE_URL>/api/auth/google/callback as an authorized redirect URI
# on the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=brighamlarsonpianos.com
#GOOGLE_ALLOWED_EMAILS=extra@gmail.com,another@gmail.com
PUBLIC_BASE_URL=http://localhost:8873

# ---- In-app agent runner (cloud brain; no Hermes, no Mac) ----
ANTHROPIC_API_KEY=
#AGENT_MODEL=claude-sonnet-5-5
VAULT_GITHUB_TOKEN=            # fine-grained PAT, Contents read/write on karmel-spec/blp-knowledge-vault
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
BLP_ARNOLD_ACCESS_KEY=         # Sales Console key (read leads, save drafts, Top Ten)
SALES_APP_URL=https://blpsalesapp.netlify.app

# ---- Telegram (cloud agent runtime, phase 1 = Arnold) ----
# One bot token per agent, from @BotFather. Never in the vault or chat.
TELEGRAM_BOT_TOKEN_ARNOLD=
# The BLP Sales Team group (negative id for groups). Arnold's 7:30 brief and 8:00 briefing post here,
# and the bot answers in this chat when @mentioned.
TELEGRAM_CHAT_ID=
# Optional: extra chat/user ids the bot may answer (private chats). Unknown chats are told their id.
#TELEGRAM_ALLOWED_CHATS_ARNOLD=123456789,987654321
# Optional: fixed webhook secret (otherwise derived from the bot token).
#TELEGRAM_WEBHOOK_SECRET=
# Optional kill switch for Arnold's cloud schedule (manual runs still work).
#ARNOLD_SCHEDULE_PAUSED=1

# ---- Cristofori GrokBot (Chris). Names only — values live in Netlify. ----
# Both URL and KEY must be set or Chris stays on the in-app Claude mind.
# See CUTOVER.md before setting the Telegram webhook.
CHRIS_GROKBOT_WEBHOOK_URL=
CHRIS_GROKBOT_WEBHOOK_KEY=
# Optional. Default is Authorization: Bearer <key>. When set, this header name
# is used and the key is sent as the raw header value.
#CHRIS_GROKBOT_WEBHOOK_KEY_HEADER=
# Grok Bot sends this as x-chris-bridge-secret on POST /api/chris/reply.
CHRIS_BRIDGE_SECRET=
# @chrislarsonbot. Allowed list is Brigham + Karmel (Telegram user ids), comma-separated.
# Do not rely on TELEGRAM_CHAT_ID — that is the sales group, and Chris does not answer there
# unless an id is listed here.
TELEGRAM_BOT_TOKEN_CHRIS=
TELEGRAM_ALLOWED_CHATS_CHRIS=
# Letters, digits, underscore, and hyphen only (Telegram secret_token rules).
TELEGRAM_WEBHOOK_SECRET_CHRIS=
