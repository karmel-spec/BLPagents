# BLP Agent Console — environment
# Copy to .env.local for local dev; set the same vars on Netlify for production.

# Leads Log spreadsheet (heartbeats land in its "Agent Status" tab).
# Defaults to the BLP Leads Log; override only for testing.
#SHEET_ID=

# Google service account with Editor access to the Leads Log.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Team passcode gating the app. Unset = open (local dev only).
BLP_APP_ACCESS_KEY=

# Key heartbeat reporters send in x-blp-key to POST /api/agents/heartbeat.
# Reporters may keep posting to the Sales Console instead — same status tab.
BLP_AGENT_KEY=
