# BLP Agent Console — environment
# Copy to .env.local for local dev; set the same vars on Netlify for production.

# Leads Log spreadsheet (heartbeats land in its "Agent Status" tab).
# Defaults to the BLP Leads Log; override only for testing.
#SHEET_ID=

# Google service account with Editor access to the Leads Log.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Team passcode gating the app. Unset = open (local dev only).
BLP_APP_ACCESS_KEY=

# Key heartbeat reporters send in x-blp-key to POST /api/agents/heartbeat.
# Reporters may keep posting to the Sales Console instead — same status tab.
BLP_AGENT_KEY=

# Google sign-in (domain-restricted OAuth). Add
# <PUBLIC_BASE_URL>/api/auth/google/callback as an authorized redirect URI
# on the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=brighamlarsonpianos.com
#GOOGLE_ALLOWED_EMAILS=extra@gmail.com,another@gmail.com
PUBLIC_BASE_URL=http://localhost:8873

# ---- In-app agent runner (cloud brain; no Hermes, no Mac) ----
ANTHROPIC_API_KEY=
#AGENT_MODEL=claude-sonnet-5-5
VAULT_GITHUB_TOKEN=            # fine-grained PAT, Contents read/write on karmel-spec/blp-knowledge-vault
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
BLP_ARNOLD_ACCESS_KEY=         # Sales Console key (read leads, save drafts, Top Ten)
SALES_APP_URL=https://blpsalesapp.netlify.app

# ---- Telegram (cloud agent runtime, phase 1 = Arnold) ----
# One bot token per agent, from @BotFather. Never in the vault or chat.
TELEGRAM_BOT_TOKEN_ARNOLD=
# The BLP Sales Team group (negative id for groups). Arnold's 7:30 brief and 8:00 briefing post here,
# and the bot answers in this chat when @mentioned.
TELEGRAM_CHAT_ID=
# Optional: extra chat/user ids the bot may answer (private chats). Unknown chats are told their id.
#TELEGRAM_ALLOWED_CHATS_ARNOLD=123456789,987654321
# Optional: fixed webhook secret (otherwise derived from the bot token).
#TELEGRAM_WEBHOOK_SECRET=
# Optional kill switch for Arnold's cloud schedule (manual runs still work).
#ARNOLD_SCHEDULE_PAUSED=1

# ---- Cristofori GrokBot (Chris). Names only — values live in Netlify. ----
# Both URL and KEY must be set or Chris stays on the in-app Claude mind.
# See CUTOVER.md before setting the Telegram webhook.
CHRIS_GROKBOT_WEBHOOK_URL=
CHRIS_GROKBOT_WEBHOOK_KEY=
# Optional. Default is Authorization: Bearer <key>. When set, this header name
# is used and the key is sent as the raw header value.
#CHRIS_GROKBOT_WEBHOOK_KEY_HEADER=
# Grok Bot sends this as x-chris-bridge-secret on POST /api/chris/reply.
CHRIS_BRIDGE_SECRET=
# @chrislarsonbot. Allowed list is Brigham + Karmel (Telegram user ids), comma-separated.
# Do not rely on TELEGRAM_CHAT_ID — that is the sales group, and Chris does not answer there
# unless an id is listed here.
TELEGRAM_BOT_TOKEN_CHRIS=
TELEGRAM_ALLOWED_CHATS_CHRIS=
# Letters, digits, underscore, and hyphen only (Telegram secret_token rules).
TELEGRAM_WEBHOOK_SECRET_CHRIS=

# ---- Eddy Bot (Grok Bot). Slug stays `ed`. Names only — values live in Netlify. ----
# Both URL and KEY must be set or Eddy's in-app chat stays closed. Eddy has no Claude fallback.
# Payload matches Chris: conversation_id, channel (telegram|app), app, sender {name,id},
# text, history (previous 10 turns: role, name, text, at), sent_at.
# When the caller passes context it is added as `context` (serial, piano, card_url, user, …).
EDDY_GROKBOT_WEBHOOK_URL=
EDDY_GROKBOT_WEBHOOK_KEY=
# Optional. Default is Authorization: Bearer <key>. When set, this header name
# is used and the key is sent as the raw header value (no Bearer prefix).
# Letters, digits, and hyphens only.
#EDDY_GROKBOT_WEBHOOK_KEY_HEADER=
# Eddy Bot sends this as x-eddy-bridge-secret on POST /api/eddy/reply.
EDDY_BRIDGE_SECRET=
# @edlarsonbot. BotFather token. The env name is TELEGRAM_BOT_TOKEN_ED because the
# slug is `ed` (not EDDY). telegramActive in the registry stays false until this
# is set and the sheet's "telegram active" cell is Y. POST /api/telegram/ed/setup
# returns 503 until the token exists. Do not commit the token.
TELEGRAM_BOT_TOKEN_ED=
# Comma-separated Telegram user ids who may DM @edlarsonbot. Put Alisa's id here
# (DM the bot once; if she isn't listed it replies with her numeric id).
# Eddy does not inherit TELEGRAM_CHAT_ID (the sales group) unless that id is listed here.
TELEGRAM_ALLOWED_CHATS_ED=
# Optional. If unset, /api/telegram/ed/setup derives a webhook secret from the bot token.
# A value here is shared with every agent that doesn't have its own secret (Chris uses
# TELEGRAM_WEBHOOK_SECRET_CHRIS instead).
#TELEGRAM_WEBHOOK_SECRET=

# Opening Eddy from another site (Marketing Engine: https://blpmarketing.netlify.app).
# That origin is allowlisted for CORS (assistant.js and /api/agents/<slug>/chat) and
# for framing /agents/<slug>/chat. Deploy-preview hostnames are not allowlisted.
# The session cookie is SameSite=Lax, so a cross-origin fetch from the marketing
# site will not be signed in. Open a top-level window (popup or link). An iframe
# is allowed but third-party cookies are often blocked.
#
# 1) Script + per-card button (preferred). data-agents="" hides the floating faces.
#    <script src="https://blpagents.netlify.app/assistant.js" defer
#            data-app="Marketing Engine" data-agents=""></script>
#    <button type="button" onclick="BLPAssistant.open('ed', {
#      app: 'Marketing Engine',
#      serial: '48211',
#      piano: 'Steinway M',
#      card: 'https://blpmarketing.netlify.app/video?q=48211',
#      user: 'Alisa'
#    })">Ask Eddy</button>
#    open() also postMessages { type: 'blp-agent-context', slug, app, serial, piano, card, user, text }
#    to the popup (target origin https://blpagents.netlify.app). The chat replies
#    { type: 'blp-agent-context-ack', slug: 'ed' }.
#
# 2) Plain link / URL params (same fields). `card` is stored as context.card_url.
#    https://blpagents.netlify.app/agents/ed/chat?app=Marketing%20Engine&serial=48211&piano=Steinway%20M&card=https%3A%2F%2Fblpmarketing.netlify.app%2Fvideo%3Fq%3D48211&user=Alisa
#
# 3) postMessage into a window you already opened (origin must be an allowlisted app):
#    chat.postMessage({ type: 'blp-agent-context', slug: 'ed', serial: '48211', piano: 'Steinway M', card: 'https://blpmarketing.netlify.app/video?q=48211', user: 'Alisa' }, 'https://blpagents.netlify.app')
#
# The signed-in console name (Google) is the sender. `user` is used only when the
# console session is the shared passcode ("Team"). After sign-in, the chat URL is
# preserved (?next=) so the serial and card are not dropped.
